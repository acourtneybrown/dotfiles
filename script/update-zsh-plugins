#!/usr/bin/env bash

set -e
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/..

git subtree pull --prefix dotfiles/oh-my-zsh-custom/plugins/evalcache https://github.com/mroth/evalcache.git master --squash

# NOTE: Any additions or removals of git subtree prefixes require updating .pre-commit-config.yaml & shellcheck.yaml
