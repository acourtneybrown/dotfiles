#!/usr/bin/env bash

function apply_sbx_network_allows() {
	local NETWORK_ALLOWS

	NETWORK_ALLOWS="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/resources/sbx_network_allows.txt"

	if ! command -v sbx >/dev/null 2>&1; then
		echo "sbx is not installed!" >&2
		return 1
	fi

	while read -r network; do
		# allow entries in sbx_network_allows.txt are host[:port] combos, one per line,
		# with optional comments prefixed by `#`
		if [[ -n "${network}" && "${network}" != \#* ]]; then
			sbx policy allow network "${network}"
		fi
	done < "${NETWORK_ALLOWS}"
}

apply_sbx_network_allows "$@"
